# Production Environment Variables for SilentLink
# Copy this file to .env.production and fill in the values

# Security
SECRET_KEY=generate-a-strong-random-secret-key-here-minimum-32-chars

# Database
DATABASE_URL=sqlite:///data/silentlink.db  # For SQLite
# For PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://user:password@postgres-host:5432/silentlink_db

# Server Configuration
HOST=0.0.0.0  # Bind to all interfaces
PORT=8000

# Session Configuration
SESSION_COOKIE_NAME=silentlink_session
SESSION_COOKIE_SECURE=true  # Set to true if using HTTPS
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# CORS Configuration (if frontend is on different domain)
# CORS_ORIGINS=https://your-frontend-domain.com

# Logging
LOG_LEVEL=INFO

# Optional: External Services
# SENTRY_DSN=your-sentry-dsn-here-for-error-tracking
# GOOGLE_TRANSLATE_API_KEY=your-google-translate-key-if-using